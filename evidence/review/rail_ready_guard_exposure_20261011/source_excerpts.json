            {
              "line": 1649,
              "text": "function OpexAI::_finalizeC75PassOutcome(year, builtCount, c75KPassData, c75StopReason,"
            },
            {
              "line": 1650,
              "text": "                                         c80DiscardsThisPass)"
            },
            {
              "line": 1651,
              "text": "{"
            },
            {
              "line": 1652,
              "text": "  if (builtCount > 0 && c75StopReason == null) {"
            },
            {
              "line": 1653,
              "text": "    if (c80DiscardsThisPass > 0) {"
            },
            {
              "line": 1654,
              "text": "      c75StopReason = \"marginal_floor\";"
            },
            {
              "line": 1655,
              "text": "    } else {"
            },
            {
              "line": 1656,
              "text": "      c75StopReason = (!C75_MULTI_BUILD) ? \"single\" : \"list_end\";"
            },
            {
              "line": 1657,
              "text": "    }"
            },
            {
              "line": 1658,
              "text": "  }"
            },
            {
              "line": 1659,
              "text": "  if (C49_SCARCITY_LEDGER && this._c49ScarcityLedger != null && builtCount > 0) {"
            },
            {
              "line": 1660,
              "text": "    if (c75StopReason == \"k_pass\") this._c49ScarcityLedger.stop_k_pass++;"
            },
            {
              "line": 1661,
              "text": "    else if (c75StopReason == \"cash\") this._c49ScarcityLedger.stop_cash++;"
            },
            {
              "line": 1662,
              "text": "    else if (c75StopReason == \"rail_search\") this._c49ScarcityLedger.stop_rail_search++;"
            },
            {
              "line": 1663,
              "text": "    else if (c75StopReason == \"list_end\") this._c49ScarcityLedger.stop_list_end++;"
            },
            {
              "line": 1664,
              "text": "    else this._c49ScarcityLedger.stop_other++;"
            },
            {
              "line": 1665,
              "text": "  }"
            },
            {
              "line": 1666,
              "text": "  if (C75_KPASS_BYPASS && builtCount > 0) OpexC75BypassRecordStop(c75StopReason);"
            },
            {
              "line": 1667,
              "text": "  OpexC75RecordPassOutcome(year, builtCount, c75KPassData, c75StopReason);"
            },
            {
              "line": 1668,
              "text": "  return c75StopReason;"
            }
          ]
        },
        {
