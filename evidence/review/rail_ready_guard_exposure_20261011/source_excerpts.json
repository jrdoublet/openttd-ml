            },
            {
              "line": 2166,
              "text": "          if (C75_KPASS_BYPASS) OpexC75BypassRecordStop(\"rail_search\");"
            },
            {
              "line": 2167,
              "text": "          OpexC75RecordPassOutcome(year, builtCount, c75KPassData, \"rail_search\");"
            },
            {
              "line": 2168,
              "text": "        }"
            },
            {
              "line": 2169,
              "text": "        if (spPass != null) {"
            },
            {
              "line": 2170,
              "text": "          OpexSpanEvent(\"projects_stop\", \"reason=rail_search\");"
            },
            {
              "line": 2171,
