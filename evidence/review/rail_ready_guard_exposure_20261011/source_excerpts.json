          "numbered_lines": [
            {
              "line": 1671,
              "text": "function OpexAI::_tryBuildProjects(year)"
            },
            {
              "line": 1672,
              "text": "{"
            },
            {
              "line": 1673,
              "text": "  if (RAIL_COOPERATIVE_N2) this._railN2Promote();"
            },
            {
              "line": 1674,
              "text": "  /* V133 : a 0, seul ce booleen. Les tables ne sont pas touchees. */"
            },
            {
              "line": 1675,
              "text": "  if (V133_AIR_BUILD_RETRY) {"
            },
            {
              "line": 1676,
              "text": "    V133_AIR_BATCH_FAILED = {};"
            },
            {
              "line": 1677,
              "text": "    V133_AIR_SKIP_LOGGED = {};"
            },
            {
              "line": 1678,
              "text": "  }"
            },
            {
              "line": 1679,
              "text": "  local spPass = PROBE_SPAN_TRACE ? OpexSpanBegin(\"projects.pass\") : null;"
            },
            {
              "line": 1680,
              "text": "  if (R1_R3_TEST_ONLY) R1_R3_TEST_PASS++;"
            },
            {
              "line": 1681,
              "text": "  local c75KPassData = null;"
            },
            {
              "line": 1682,
              "text": "  local c75StopReason = null;"
            },
            {
              "line": 1683,
              "text": "  local c75BuiltKeys = {};"
            },
            {
              "line": 1684,
              "text": "  local c75BypassConsumed = false;"
            },
            {
              "line": 1685,
              "text": "  local c121FirstYearAirBatch = C121_CATALOG_AIR_FIRST_YEAR"
            },
            {
              "line": 1686,
              "text": "      && this._generationStageMonth >= 0"
            },
            {
              "line": 1687,
              "text": "      && year == (this._generationStageMonth - 1) / 12;"
            },
            {
              "line": 1688,
              "text": "  local c121AirBuilt = 0;"
            },
            {
              "line": 1689,
              "text": "  local c121AirChained = 0;"
            },
            {
              "line": 1690,
              "text": "  local c121DeadSkipped = 0;"
            },
            {
              "line": 1691,
              "text": "  /* Sonde PROJECTS_COST (catalog_cost_probe) : repartition des opcodes d'une passe. */"
            },
            {
              "line": 1692,
              "text": "  local pcost = CATALOG_COST_PROBE"
            },
            {
              "line": 1693,
              "text": "      ? { mark = OpexOpsMeasureBegin(), buildOps = 0, fleetOps = 0, regenOps = 0, regenKind = \"none\" }"
            },
            {
              "line": 1694,
              "text": "      : null;"
            },
            {
              "line": 1695,
              "text": "  if (C75_KPASS_BYPASS) OpexC75BypassEnsureYear(year);"
            },
            {
              "line": 1696,
              "text": "  if (C75_TRACK_PASSES) {"
            },
            {
              "line": 1697,
              "text": "    local now = AIDate.GetCurrentDate();"
            },
            {
              "line": 1698,
              "text": "    OpexC75RecordPassDate(now);"
            },
            {
              "line": 1699,
              "text": "    c75KPassData = OpexC75ComputeKPass(now);"
            },
            {
              "line": 1700,
              "text": "    if (C75_YEAR_LEDGER != null) C75_YEAR_LEDGER.passes++;"
            },
            {
              "line": 1701,
              "text": "  }"
            },
            {
              "line": 1702,
              "text": "  if (spPass != null) {"
            },
            {
              "line": 1703,
              "text": "    local beginCash = AICompany.GetBankBalance(AICompany.COMPANY_SELF);"
            },
            {
              "line": 1704,
              "text": "    local beginAvail = OpexAvailableCapital();"
            },
            {
              "line": 1705,
              "text": "    local beginK = (c75KPassData != null && (\"K_pass\" in c75KPassData)) ? c75KPassData.K_pass : -1;"
            },
            {
              "line": 1706,
              "text": "    local beginPool = (this._projects != null && this._projects.best != null) ? this._projects.best.len() : 0;"
            },
            {
              "line": 1707,
              "text": "    OpexSpanEvent(\"projects_begin\", \"cash=\" + beginCash + \" avail=\" + beginAvail + \" k_pass=\" + beginK + \" pool=\" + beginPool);"
            },
            {
              "line": 1708,
              "text": "  }"
            },
            {
              "line": 1709,
              "text": "  local c80DiscardsThisPass = 0;"
            },
            {
              "line": 1710,
              "text": ""
            },
            {
              "line": 1711,
              "text": "  /* C83.1 : detecter d'abord une transition de slot qui exige un candidat absent,"
            },
            {
              "line": 1712,
              "text": "   * puis reevaluer le petit portefeuille deja finance avant toute depense. */"
            },
            {
              "line": 1713,
              "text": "  if (this._projects != null) {"
            },
            {
              "line": 1714,
              "text": "    if (C83_PREEMPT_OPEN) this._c83PreemptEnqueued = 0;"
            },
            {
              "line": 1715,
              "text": "    local c83TargetedRegens = 0;"
            },
            {
              "line": 1716,
              "text": "    c83TargetedRegens = this._c83WatchAirSlotTransitions();"
            },
            {
              "line": 1717,
              "text": "    if (C83_PREEMPT_OPEN && this._c83PreemptEnqueued > 0) {"
            },
            {
              "line": 1718,
              "text": "      c83TargetedRegens += this._c83PreemptEnqueued;"
            },
            {
              "line": 1719,
              "text": "    }"
            },
            {
              "line": 1720,
              "text": "    if (spPass != null && c83TargetedRegens > 0) {"
            },
            {
              "line": 1721,
              "text": "      OpexSpanEvent(\"projects_stop\", \"reason=c83_preempt\");"
            },
            {
              "line": 1722,
              "text": "      OpexSpanEnd(spPass);"
            },
            {
              "line": 1723,
              "text": "    }"
            },
            {
              "line": 1724,
              "text": "    if (c83TargetedRegens > 0) return true;"
            }
          ]
