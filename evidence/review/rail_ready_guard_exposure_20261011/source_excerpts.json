    {
      "bundle_relative_path": "ai/OpexAI/probes.nut",
      "full_file_sha256": "547b0040deab0c95ae1eb6996991061adf18ecf37d81e0a99a326729b2864b52",
      "excerpts": [
        {
          "start_line": 1977,
          "end_line": 2040,
          "numbered_lines": [
            {
              "line": 1977,
              "text": "function OpexC75RecordPassDate(now = null)"
            },
            {
              "line": 1978,
              "text": "{"
            },
            {
              "line": 1979,
              "text": "  if (!C75_TRACK_PASSES) return;"
            },
            {
              "line": 1980,
              "text": "  if (C75_PASS_DATES == null) C75_PASS_DATES = [];"
            },
            {
              "line": 1981,
              "text": "  if (now == null) now = AIDate.GetCurrentDate();"
            },
            {
              "line": 1982,
              "text": "  C75_PASS_DATES.append(now);"
            },
            {
              "line": 1983,
              "text": ""
            },
            {
              "line": 1984,
              "text": "  local startDate = AIDate.GetDate(OPEX_START_YEAR, 1, 1);"
            },
            {
              "line": 1985,
              "text": "  local daysSinceStart = now - startDate;"
            },
            {
              "line": 1986,
              "text": "  if (daysSinceStart < 1) daysSinceStart = 1;"
            },
            {
              "line": 1987,
              "text": "  local D = daysSinceStart < 365 ? daysSinceStart : 365;"
            },
            {
              "line": 1988,
              "text": ""
            },
            {
              "line": 1989,
              "text": "  local cutoff = now - D;"
            },
            {
              "line": 1990,
              "text": "  local pruned = [];"
            },
            {
              "line": 1991,
              "text": "  foreach (d in C75_PASS_DATES) {"
            },
            {
              "line": 1992,
              "text": "    if (d >= cutoff) {"
            },
            {
              "line": 1993,
              "text": "      pruned.append(d);"
            },
            {
              "line": 1994,
              "text": "    }"
            },
            {
              "line": 1995,
              "text": "  }"
            },
            {
              "line": 1996,
              "text": "  C75_PASS_DATES = pruned;"
            },
            {
              "line": 1997,
              "text": "}"
            },
            {
              "line": 1998,
              "text": ""
            },
            {
              "line": 1999,
              "text": "/* C75 : calcul de K_pass = F * tau_pass sur la fenetre glissante min(365, jours depuis debut)."
            },
            {
              "line": 2000,
              "text": " * Moins de 2 passes dans la fenetre => K_pass = 0. */"
            },
            {
              "line": 2001,
              "text": "function OpexC75ComputeKPass(now = null)"
            },
            {
              "line": 2002,
              "text": "{"
            },
            {
              "line": 2003,
              "text": "  if (now == null) now = AIDate.GetCurrentDate();"
            },
            {
              "line": 2004,
              "text": "  local flow = OpexComputeOperatingCashFlow(now);"
            },
            {
              "line": 2005,
              "text": "  local F = flow.F;"
            },
            {
              "line": 2006,
              "text": ""
            },
            {
              "line": 2007,
              "text": "  local startDate = AIDate.GetDate(OPEX_START_YEAR, 1, 1);"
            },
            {
              "line": 2008,
              "text": "  local daysSinceStart = now - startDate;"
            },
            {
              "line": 2009,
              "text": "  if (daysSinceStart < 1) daysSinceStart = 1;"
            },
            {
              "line": 2010,
              "text": "  local D = daysSinceStart < 365 ? daysSinceStart : 365;"
            },
            {
              "line": 2011,
              "text": ""
            },
            {
              "line": 2012,
              "text": "  local N = 0;"
            },
            {
              "line": 2013,
              "text": "  if (C75_PASS_DATES != null) {"
            },
            {
              "line": 2014,
              "text": "    local cutoff = now - D;"
            },
            {
              "line": 2015,
              "text": "    local pruned = [];"
            },
            {
              "line": 2016,
              "text": "    foreach (d in C75_PASS_DATES) {"
            },
            {
              "line": 2017,
              "text": "      if (d >= cutoff) {"
            },
            {
              "line": 2018,
              "text": "        pruned.append(d);"
            },
            {
              "line": 2019,
              "text": "      }"
            },
            {
              "line": 2020,
              "text": "    }"
            },
            {
              "line": 2021,
              "text": "    C75_PASS_DATES = pruned;"
            },
            {
              "line": 2022,
              "text": "    N = C75_PASS_DATES.len();"
            },
            {
              "line": 2023,
              "text": "  }"
            },
            {
              "line": 2024,
              "text": ""
            },
            {
              "line": 2025,
              "text": "  local tau_pass = 0.0;"
            },
            {
              "line": 2026,
              "text": "  local K_pass = 0;"
            },
            {
              "line": 2027,
              "text": "  if (N >= 2 && F > 0.0) {"
            },
            {
              "line": 2028,
              "text": "    tau_pass = D.tofloat() / N.tofloat();"
            },
            {
              "line": 2029,
              "text": "    K_pass = (F * tau_pass).tointeger();"
            },
            {
              "line": 2030,
              "text": "    if (K_pass < 0) K_pass = 0;"
            },
            {
              "line": 2031,
              "text": "  }"
            },
            {
              "line": 2032,
              "text": ""
            },
            {
              "line": 2033,
              "text": "  return {"
            },
            {
              "line": 2034,
              "text": "    F = F,"
            },
            {
              "line": 2035,
              "text": "    tau_pass = tau_pass,"
            },
            {
              "line": 2036,
              "text": "    K_pass = K_pass,"
            },
            {
              "line": 2037,
              "text": "    D = D,"
            },
            {
              "line": 2038,
              "text": "    N = N,"
            },
            {
              "line": 2039,
              "text": "    daysCovered = flow.daysCovered"
            },
            {
              "line": 2040,
              "text": "  };"
            }
          ]
        },
        {
          "start_line": 2157,
          "end_line": 2209,
          "numbered_lines": [
            {
              "line": 2157,
              "text": "function OpexC75BypassRecordStop(stopReason)"
            },
            {
              "line": 2158,
              "text": "{"
            },
            {
              "line": 2159,
              "text": "  if (!C75_KPASS_BYPASS || C75_KPASS_BYPASS_LEDGER == null || stopReason == null) return;"
            },
            {
              "line": 2160,
              "text": "  if (stopReason == \"k_pass\") C75_KPASS_BYPASS_LEDGER.stop_k_pass++;"
            },
            {
              "line": 2161,
              "text": "  else if (stopReason == \"cash\") C75_KPASS_BYPASS_LEDGER.stop_cash++;"
            },
            {
              "line": 2162,
              "text": "  else if (stopReason == \"rail_search\") C75_KPASS_BYPASS_LEDGER.stop_rail_search++;"
            },
            {
              "line": 2163,
              "text": "  else if (stopReason == \"list_end\") C75_KPASS_BYPASS_LEDGER.stop_list_end++;"
            },
            {
              "line": 2164,
              "text": "  else C75_KPASS_BYPASS_LEDGER.stop_other++;"
            },
            {
              "line": 2165,
              "text": "}"
            },
            {
              "line": 2166,
              "text": ""
            },
            {
              "line": 2167,
              "text": "function OpexC75BypassFlushYear(year)"
            },
            {
              "line": 2168,
              "text": "{"
            },
            {
              "line": 2169,
              "text": "  if (!C75_KPASS_BYPASS || C75_KPASS_BYPASS_LEDGER == null) return;"
            },
            {
              "line": 2170,
              "text": "  AILog.Info(\"C75_BYPASS phase=year year=\" + year"
            },
            {
              "line": 2171,
              "text": "      + \" eligible=\" + C75_KPASS_BYPASS_LEDGER.eligible"
            },
            {
              "line": 2172,
              "text": "      + \" consumed=\" + C75_KPASS_BYPASS_LEDGER.consumed"
            },
            {
              "line": 2173,
              "text": "      + \" fleet_consumed=\" + C75_KPASS_BYPASS_LEDGER.fleet_consumed"
            },
            {
              "line": 2174,
              "text": "      + \" stop_k_pass=\" + C75_KPASS_BYPASS_LEDGER.stop_k_pass"
            },
            {
              "line": 2175,
              "text": "      + \" stop_cash=\" + C75_KPASS_BYPASS_LEDGER.stop_cash"
            },
            {
              "line": 2176,
              "text": "      + \" stop_rail_search=\" + C75_KPASS_BYPASS_LEDGER.stop_rail_search"
            },
            {
              "line": 2177,
              "text": "      + \" stop_list_end=\" + C75_KPASS_BYPASS_LEDGER.stop_list_end"
            },
            {
              "line": 2178,
              "text": "      + \" stop_other=\" + C75_KPASS_BYPASS_LEDGER.stop_other);"
            },
            {
              "line": 2179,
              "text": "  OpexSign(AIMap.GetTileIndex(3, 8), \"C7Y|\" + (year % 100)"
            },
            {
              "line": 2180,
              "text": "      + \"|\" + C75_KPASS_BYPASS_LEDGER.eligible"
            },
            {
              "line": 2181,
              "text": "      + \"|\" + C75_KPASS_BYPASS_LEDGER.consumed"
            },
            {
              "line": 2182,
              "text": "      + \"|\" + C75_KPASS_BYPASS_LEDGER.fleet_consumed);"
            },
            {
              "line": 2183,
              "text": "  OpexSign(AIMap.GetTileIndex(3, 9), \"C7S|\" + (year % 100)"
            },
            {
              "line": 2184,
              "text": "      + \"|\" + C75_KPASS_BYPASS_LEDGER.stop_k_pass"
            },
            {
              "line": 2185,
              "text": "      + \"|\" + C75_KPASS_BYPASS_LEDGER.stop_cash"
            },
            {
              "line": 2186,
              "text": "      + \"|\" + C75_KPASS_BYPASS_LEDGER.stop_rail_search"
            },
            {
              "line": 2187,
              "text": "      + \"|\" + C75_KPASS_BYPASS_LEDGER.stop_list_end"
            },
            {
              "line": 2188,
              "text": "      + \"|\" + C75_KPASS_BYPASS_LEDGER.stop_other);"
            },
            {
              "line": 2189,
              "text": "  OpexC75BypassResetYearLedger();"
            },
            {
              "line": 2190,
              "text": "}"
            },
            {
              "line": 2191,
              "text": ""
            },
            {
              "line": 2192,
              "text": "/* C75 : enregistre le resultat d'une passe et publie phase=c75_pass si au moins 1 chantier */"
            },
            {
              "line": 2193,
              "text": "function OpexC75RecordPassOutcome(year, builtCount, c75KPassData, stopReason)"
            },
            {
              "line": 2194,
              "text": "{"
            },
            {
              "line": 2195,
              "text": "  if (!C75_TRACK_PASSES) return;"
            },
            {
              "line": 2196,
              "text": "  if (C75_YEAR_LEDGER != null) {"
            },
            {
              "line": 2197,
              "text": "    C75_YEAR_LEDGER.builds += builtCount;"
            },
            {
              "line": 2198,
              "text": "    if (builtCount > 1) C75_YEAR_LEDGER.multi_passes++;"
            },
            {
              "line": 2199,
              "text": "  }"
            },
            {
              "line": 2200,
              "text": "  if (builtCount > 0 && C69_BOTTLENECK_PROBE) {"
            },
            {
              "line": 2201,
              "text": "    local kPass = (c75KPassData != null) ? c75KPassData.K_pass : 0;"
            },
            {
              "line": 2202,
              "text": "    local tauPass = (c75KPassData != null) ? c75KPassData.tau_pass : 0.0;"
            },
            {
              "line": 2203,
              "text": "    local fVal = (c75KPassData != null) ? c75KPassData.F : 0.0;"
            },
            {
              "line": 2204,
              "text": "    local reason = (stopReason != null) ? stopReason : \"list_end\";"
            },
            {
              "line": 2205,
              "text": "    OpexC69Log(\"phase=c75_pass year=\" + year + \" built=\" + builtCount"
            },
            {
              "line": 2206,
              "text": "        + \" k_pass=\" + kPass + \" tau_pass=\" + tauPass + \" F=\" + fVal"
            },
            {
              "line": 2207,
              "text": "        + \" stop=\" + reason);"
            },
            {
              "line": 2208,
              "text": "  }"
            },
            {
              "line": 2209,
              "text": "}"
            }
          ]
        },
        {
          "start_line": 2233,
          "end_line": 2239,
          "numbered_lines": [
            {
              "line": 2233,
              "text": "function OpexC75FlushYear(year)"
            },
            {
              "line": 2234,
              "text": "{"
            },
            {
              "line": 2235,
              "text": "  if (!C69_BOTTLENECK_PROBE || C75_YEAR_LEDGER == null) return;"
            },
            {
              "line": 2236,
              "text": "  if (year < 1970) return;"
            },
            {
              "line": 2237,
              "text": ""
            },
            {
              "line": 2238,
              "text": "  OpexC69Log(\"phase=c75_year year=\" + year + \" passes=\" + C75_YEAR_LEDGER.passes"
            },
            {
              "line": 2239,
              "text": "      + \" builds=\" + C75_YEAR_LEDGER.builds + \" multi_passes=\" + C75_YEAR_LEDGER.multi_passes);"
            }
          ]
        }
      ]
