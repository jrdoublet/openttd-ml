    {
      "bundle_relative_path": "ai/OpexAI/opcode_exact.nut",
      "full_file_sha256": "19bb9b4fc950ad5f6c4bae9f2f22e22138a46da09eea0de828366cbb1db2e39b",
      "excerpts": [
        {
          "start_line": 75,
          "end_line": 115,
          "numbered_lines": [
            {
              "line": 75,
              "text": "    local prev = OPCODE_EXACT_CAL_YEAR;"
            },
            {
              "line": 76,
              "text": "    OPCODE_EXACT_CAL_YEAR = year;"
            },
            {
              "line": 77,
              "text": "    OpexOpcodeExactPublishYear(prev);"
            },
            {
              "line": 78,
              "text": "    return;"
            },
            {
              "line": 79,
              "text": "  }"
            },
            {
              "line": 80,
              "text": "  if (AIDate.GetMonth(now) == 12 && AIDate.GetDayOfMonth(now) >= 28"
            },
            {
              "line": 81,
              "text": "      && OPCODE_EXACT_LATE_DATE != now) {"
            },
            {
              "line": 82,
              "text": "    OPCODE_EXACT_LATE_DATE = now;"
            },
            {
              "line": 83,
              "text": "    OpexOpcodeExactPublishYear(year);"
            },
            {
              "line": 84,
              "text": "  }"
            },
            {
              "line": 85,
              "text": "}"
            },
            {
              "line": 86,
              "text": ""
            },
            {
              "line": 87,
              "text": "function OpexOpcodeExactAdd(site, opsOld, opsNew, same, detail) {"
            },
            {
              "line": 88,
              "text": "  if (!EXP_OPCODE_EXACT_CHECK) return;"
            },
            {
              "line": 89,
              "text": "  OpexOpcodeExactObserveCalendar();"
            },
            {
              "line": 90,
              "text": "  local year = AIDate.GetYear(AIDate.GetCurrentDate());"
            },
            {
              "line": 91,
              "text": "  local bySite = OpexOpcodeExactEnsureYear(year);"
            },
            {
              "line": 92,
              "text": "  local rec = (site in bySite) ? bySite[site] : null;"
            },
            {
              "line": 93,
              "text": "  if (rec == null) {"
            },
            {
              "line": 94,
              "text": "    rec = { calls = 0, mismatch = 0, opsOld = 0, opsNew = 0 };"
            },
            {
              "line": 95,
              "text": "    bySite.rawset(site, rec);"
            },
            {
              "line": 96,
              "text": "  }"
            },
            {
              "line": 97,
              "text": "  rec.calls++;"
            },
            {
              "line": 98,
              "text": "  rec.opsOld += opsOld;"
            },
            {
              "line": 99,
              "text": "  rec.opsNew += opsNew;"
            },
            {
              "line": 100,
              "text": "  if (same) return;"
            },
            {
              "line": 101,
              "text": "  rec.mismatch++;"
            },
            {
              "line": 102,
              "text": "  if (OPCODE_EXACT_MISMATCHES == null) OPCODE_EXACT_MISMATCHES = {};"
            },
            {
              "line": 103,
              "text": "  local n = (site in OPCODE_EXACT_MISMATCHES) ? OPCODE_EXACT_MISMATCHES[site] : 0;"
            },
            {
              "line": 104,
              "text": "  if (n >= 5) return;"
            },
            {
              "line": 105,
              "text": "  OPCODE_EXACT_MISMATCHES.rawset(site, n + 1);"
            },
            {
              "line": 106,
              "text": "  AILog.Info(\"OPCODE_EXACT_MISMATCH site=\" + site + \" \" + detail);"
            },
            {
              "line": 107,
              "text": "}"
            },
            {
              "line": 108,
              "text": ""
            },
            {
              "line": 109,
              "text": "function OpexOpcodeExactSite(fallback) {"
            },
            {
              "line": 110,
              "text": "  if (OPCODE_EXACT_SITE_NAME != null) return OPCODE_EXACT_SITE_NAME;"
            },
            {
              "line": 111,
              "text": "  return fallback;"
            },
            {
              "line": 112,
              "text": "}"
            },
            {
              "line": 113,
              "text": ""
            },
            {
              "line": 114,
              "text": "/* Borne de Manhattan. Les anneaux 0..R visitent le disque de Chebyshev de"
            },
            {
              "line": 115,
              "text": " * rayon R : pour toute tuile balayee t, manhattan(centre, t) <= 2R."
            }
          ]
        }
      ]
    }
