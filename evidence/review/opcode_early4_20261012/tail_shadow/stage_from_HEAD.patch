+/* P0 tail shadow. Ne fait que lire des états O(1), jamais appeler step(),
+ * GetVehicle*, map, pathfinder, ni produire une commande. Un plafond d'opcodes
+ * représente une opportunité conditionnelle : les fonctions NoAI peuvent
+ * suspendre et une garde O(1) ne suffit PAS à prouver un worker prêt. */
+function OpexTailShadowClass(worker, search, prepHold, reactiveCount, c67)
+{
+  local kind = "none";
+  if (worker != null) {
+    kind = ("kind" in worker) ? worker.kind : "other";
+    if (kind != "rail_search" && kind != "rail_stock"
+        && kind != "regen_candidates" && kind != "town_growth"
+        && kind != "noop") kind = "other";
+  }
+  local phase = "none";
+  local prep = false;
+  if (search != null) {
+    phase = ("phase" in search) ? search.phase : "other";
+    if (phase != "search" && phase != "build") phase = "other";
+    prep = ("isC121RailPrep" in search) && search.isC121RailPrep;
+  }
+  /* Un hold hors contexte de prep doit aussi être visible, sans l'inférer prêt. */
+  local hold = prepHold;
+  local reactive = reactiveCount > 0;
+  /* UNKNOWN n'est jamais assimilé à READY sur la seule présence d'un état. */
+  local readiness = (worker != null || search != null || reactive || c67 != "off")
+      ? "unknown" : "none";
+  local key = kind + (prep ? (hold ? ".prep_hold" : ".prep")
+      : (hold ? ".orphan_hold" : ""))
+      + "|rail_" + phase + "|rq_" + (reactive ? "yes" : "no") + "|c67_" + c67;
+  return { key = key, readiness = readiness, reactive = reactive,
+           prep = prep, hold = hold, phase = phase, kind = kind };
+}
+
+function OpexTailShadowBudget(left)
+{
+  return left >= C67_SLACK_MIN ? left - C67_SLACK_RESERVE : 0;
+}
+
+function OpexTailShadowOps(startTick, startLeft, endTick, endLeft)
+{
+  local elapsed = endTick - startTick;
+  if (elapsed < 0) return 0;
+  if (elapsed == 0) return startLeft > endLeft ? startLeft - endLeft : 0;
+  return startLeft + (elapsed - 1) * OPS_PER_TICK + (OPS_PER_TICK - endLeft);
+}
+
+function OpexTailShadowEnsure()
+{
+  if (OPEX_TAIL_SHADOW == null) {
+    OPEX_TAIL_SHADOW = { low = 0, high = 0, crosses = 0,
+        guardOps = 0, guardMax = 0, beforeCap = 0, afterCap = 0,
+        unknown = 0, other = 0, buckets = {} };
+  }
+  return OPEX_TAIL_SHADOW;
+}
+
+function OpexTailShadowFlush(year)
+{
+  if (!PROBE_TAIL_SHADOW || OPEX_TAIL_SHADOW == null) return;
+  local s = OPEX_TAIL_SHADOW;
+  AILog.Info("TAIL_SHADOW y=" + year + " kind=total high=" + s.high
+      + " low=" + s.low + " crosses=" + s.crosses
+      + " guard_ops=" + s.guardOps + " guard_max=" + s.guardMax
+      + " before_cap=" + s.beforeCap + " after_cap=" + s.afterCap
+      + " unknown=" + s.unknown + " other=" + s.other);
+  foreach (key, e in s.buckets) {
+    AILog.Info("TAIL_SHADOW y=" + year + " kind=bucket state=" + key
+        + " n=" + e.n + " cap=" + e.cap + " cap_after=" + e.capAfter
+        + " guard_ops=" + e.guardOps + " crosses=" + e.crosses
+        + " rq_sum=" + e.reactiveSum + " rq_max=" + e.reactiveMax);
+  }
+  OPEX_TAIL_SHADOW = null;
+}
+
+function OpexTailShadowSample(ai)
+{
+  /* Mesuré APRES les compteurs historiques sleep_left ; aucun worker lancé. */
+  local tick0 = AIController.GetTick();
+  local left0 = AIController.GetOpsTillSuspend();
+  if (left0 < C67_SLACK_MIN) {
+    local lowState = OpexTailShadowEnsure();
+    lowState.low++;
+    return;
+  }
+
+  local s = OpexTailShadowEnsure();
+  /* C67 a déjà eu son tour en amont de cet échantillon. Un état 'hook' ou
+   * 'background' ne démontre pas de travail réellement faisable dans le reste. */
+  local c67 = "off";
+  if (C67_SLACK_HOOK) {
+    if (C67_TERRAIN_MAP && ai._c67Terrain != null && !ai._c67BgIdle)
+      c67 = "background";
+    else if (C67_WATER_EXPOSURE) c67 = "water";
+    else c67 = "hook";
+  }
+  local rqLen = ai._reactiveQueue != null ? ai._reactiveQueue.len() : 0;
+  local sample = OpexTailShadowClass(ai._activeWorker, ai._railSearch,
+      ai._c121RailPrepHold, rqLen, c67);
+  local e = (sample.key in s.buckets) ? s.buckets[sample.key] : null;
+  if (e == null) {
+    e = { n = 0, cap = 0, capAfter = 0, guardOps = 0,
+          crosses = 0, reactiveSum = 0, reactiveMax = 0 };
+    s.buckets.rawset(sample.key, e);
+  }
+  e.n++;
+  e.reactiveSum += rqLen;
+  if (rqLen > e.reactiveMax) e.reactiveMax = rqLen;
+  if (sample.readiness == "unknown") s.unknown++;
+  if (sample.kind == "other") s.other++;
+  local beforeCap = OpexTailShadowBudget(left0);
+
+  local tick1 = AIController.GetTick();
+  local left1 = AIController.GetOpsTillSuspend();
+  local guardOps = OpexTailShadowOps(tick0, left0, tick1, left1);
+  local crossed = tick1 != tick0;
+  /* Si la sonde a traversé le tick, tout prétendu plafond est annulé. */
+  local afterCap = crossed ? 0 : OpexTailShadowBudget(left1);
+  s.high++;
+  s.beforeCap += beforeCap;
+  s.afterCap += afterCap;
+  s.guardOps += guardOps;
+  if (guardOps > s.guardMax) s.guardMax = guardOps;
+  if (crossed) s.crosses++;
+  e.cap += beforeCap;
+  e.capAfter += afterCap;
+  e.guardOps += guardOps;
+  if (crossed) e.crosses++;
+}
+
 function OpexLoopProfFlushIfNewYear()
 {
