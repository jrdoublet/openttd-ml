+/* P0 : recherche binaire stable de la position d'insertion dans le cas
+ * lexicographique ordinaire (C77 / V88 / bonus early slot). Fallback legacy
+ * pour les comparateurs C118 et C122, ou les modes de diagnostic de rejets. */
+function OpexP0TopKBinaryInsert(best, project, field, limit, applyEarlySlot)
+{
+  local newTier = OpexProjectDefensiveAirPriority(project)
+      + ((V88_CHAIN_FORCE && OpexProjectIsForcedChain(project)) ? 1000 : 0);
+  local newScore = applyEarlySlot ? OpexProjectSelectionScore(project, field) : project[field];
+  local lo = 0, hi = best.len();
+  while (lo < hi) {
+    local mid = (lo + hi) / 2;
+    local prior = best[mid];
+    local oldTier = OpexProjectDefensiveAirPriority(prior)
+        + ((V88_CHAIN_FORCE && OpexProjectIsForcedChain(prior)) ? 1000 : 0);
+    local oldScore = applyEarlySlot ? OpexProjectSelectionScore(prior, field) : prior[field];
+    if (oldTier > newTier
+        || (oldTier == newTier
+            && (oldScore > newScore
+                || (oldScore == newScore && prior.revenueAnnual >= project.revenueAnnual)))) {
+      lo = mid + 1;
+    } else hi = mid;
+  }
+  best.insert(lo, project);
+  if (best.len() > limit) best.pop();
+}
+
+function OpexP0TopKRecord(oldOps, newOps, mismatch)
+{
+  local year = AIDate.GetYear(AIDate.GetCurrentDate());
+  if (P0_TOPK_BINARY_PROF == null) {
+    P0_TOPK_BINARY_PROF = {year = year, calls = 0, oldOps = 0, newOps = 0, mismatches = 0};
+  }
+  if (P0_TOPK_BINARY_PROF.year != year) {
+    local p = P0_TOPK_BINARY_PROF;
+    AILog.Info("P0_TOPK_BINARY year=" + p.year + " calls=" + p.calls
+        + " old_ops=" + p.oldOps + " new_ops=" + p.newOps
+        + " mismatches=" + p.mismatches);
+    P0_TOPK_BINARY_PROF = {year = year, calls = 0, oldOps = 0, newOps = 0, mismatches = 0};
+  }
+  local s = P0_TOPK_BINARY_PROF;
+  s.calls++;
+  s.oldOps += oldOps;
+  s.newOps += newOps;
+  if (mismatch) s.mismatches++;
+}
+
+function OpexP0TopKInsert(best, project, field, limit, applyEarlySlot = false)
+{
+  if (!P0_TOPK_BINARY && !P0_TOPK_BINARY_CHECK) {
+    OpexProjectInsertDefensive(best, project, field, limit, applyEarlySlot);
+    return;
+  }
+  local c118 = C118_AIR_TERRITORIAL_EXPANSION && C118_AIR_PROJECT_SNAPSHOT != null
+      && ("active" in C118_AIR_PROJECT_SNAPSHOT) && C118_AIR_PROJECT_SNAPSHOT.active;
+  if (c118 || C122_AIR_REGIME_PRIORITY || C122_AIR_REGIME_SHADOW
+      || AIR_EFFICIENCY_DEDUPE || PROBE_SELECT_REJECT) {
+    OpexProjectInsertDefensive(best, project, field, limit, applyEarlySlot);
+    return;
+  }
+  if (P0_TOPK_BINARY_CHECK) {
+    local copyBest = [];
+    foreach (prior in best) copyBest.append(prior);
+    local oldMark = OpexOpsMeasureBegin();
+    OpexProjectInsertDefensive(best, project, field, limit, applyEarlySlot);
+    local oldOps = OpexOpsMeasureEnd(oldMark);
+    local newMark = OpexOpsMeasureBegin();
+    OpexP0TopKBinaryInsert(copyBest, project, field, limit, applyEarlySlot);
+    local newOps = OpexOpsMeasureEnd(newMark);
+    local mismatch = copyBest.len() != best.len();
+    if (!mismatch) {
+      for (local i = 0; i < best.len(); i++) {
+        if (best[i] != copyBest[i]) { mismatch = true; break; }
+      }
+    }
+    OpexP0TopKRecord(oldOps, newOps, mismatch);
+    return; /* check force TOUJOURS le resultat historique */
+  }
+  OpexP0TopKBinaryInsert(best, project, field, limit, applyEarlySlot);
+}
