+GLOBALS = (ROOT / "ai" / "OpexAI" / "globals_pre.nut").read_text(encoding="utf-8")
+INFO = (ROOT / "ai" / "OpexAI" / "info.nut").read_text(encoding="utf-8")
+SETTINGS = (ROOT / "ai" / "OpexAI" / "settings.nut").read_text(encoding="utf-8")
+CATALOG = (ROOT / "ai" / "OpexAI" / "catalog.nut").read_text(encoding="utf-8")
+TASK_AIR = (ROOT / "ai" / "OpexAI" / "task_air.nut").read_text(encoding="utf-8")
+TASK_REPORT = (ROOT / "ai" / "OpexAI" / "task_report.nut").read_text(encoding="utf-8")
+
+
+PROJECTS = (ROOT / "ai" / "OpexAI" / "projects.nut").read_text(encoding="utf-8")
+
+
+def function_body(text, signature):
+    start = text.index(signature)
+    brace = text.index("{", start)
+    depth = 0
+    for pos in range(brace, len(text)):
+        if text[pos] == "{":
+            depth += 1
+        elif text[pos] == "}":
+            depth -= 1
+            if depth == 0:
+                return text[start:pos + 1]
+    raise AssertionError(signature)
+
+
+class V92HardeningTests(unittest.TestCase):
+    def test_new_setting_declared_loaded_default_zero(self):
+        self.assertIn("V92_REEQUIP <- false;", GLOBALS)
+        start = INFO.index('name = "v92_reequip"')
+        block = INFO[start:INFO.index("});", start)]
+        for token in ("easy_value = 0", "medium_value = 0", "hard_value = 0", "custom_value = 0"):
+            self.assertIn(token, block)
+        self.assertIn(
+            'V92_REEQUIP = V92_AIR_SERVICE_CHOICE && (AIController.GetSetting("v92_reequip") != 0);',
+            SETTINGS,
+        )
+
+        self.assertIn("V92_ENGINE_CRITERION <- 0;", GLOBALS)
+        start_crit = INFO.index('name = "v92_engine_criterion"')
+        block_crit = INFO[start_crit:INFO.index("});", start_crit)]
+        for token in ("easy_value = 0", "medium_value = 0", "hard_value = 0", "custom_value = 0"):
+            self.assertIn(token, block_crit)
+        self.assertIn(
+            'V92_ENGINE_CRITERION = AIController.GetSetting("v92_engine_criterion");',
+            SETTINGS,
+        )
+
