+/* C82 / V92.2 : evaluation calibree commune d'un appareil selon C72_PLANE_CHOICE.
+ * Renvoye un tuple { score, calProfit, calRoi, secondary } permettant la comparaison C82
+ * et le departage en bande de profit sous V92.2. */
+function OpexC82EngineScore(plane, economics, kDec = 0)
+{
+  if (plane == null || economics == null) {
+    return { score = 0.0, calProfit = 0.0, calRoi = 0.0, secondary = 0.0 };
+  }
+  local k = OpexC82EngineFactor(plane.id);
+  local calProfit = economics.profitAnnual * k;
+  local calRoi = economics.roi * k;
+  local score = 0.0;
+  local secondary = 0.0;
+
+  if (C72_PLANE_CHOICE == 1) {
+    score = calRoi;
+    secondary = calProfit;
+  } else if (C72_PLANE_CHOICE == 2) {
+    local denom = economics.capital > kDec ? economics.capital : kDec;
+    score = denom > 0 ? (calProfit.tofloat() * 1000.0) / denom : 0.0;
+    secondary = calProfit;
+  } else {
+    score = calProfit;
+    secondary = calRoi;
+  }
+  return { score = score, calProfit = calProfit, calRoi = calRoi, secondary = secondary };
+}
+
+function OpexC82ScoreBetter(cand, best)
+{
+  if (cand == null) return false;
+  if (best == null) return true;
+  if (cand.score > best.score) return true;
+  if (cand.score == best.score && cand.secondary > best.secondary) return true;
+  return false;
+}
