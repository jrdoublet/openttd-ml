+        body = function_body(CATALOG, "function OpexCatalog::_refreshAir()")
+        self.assertEqual(body.count("AIEngine.GetMaxAge(e)"), 0)
+        self.assertNotIn("ageYears", body)
+        self.assertNotIn("mailCapacity", body)
+
+    def test_hangar_timeout_and_pending_date(self):
+        reequip = function_body(BUILDER, "function OpexAirMaybeReequip(")
+        self.assertIn("line.v92PendingDate <- AIDate.GetCurrentDate();", reequip)
+        self.assertIn("waitDays > 90", reequip)
+        self.assertIn("OpexAirReleaseHangarHold(line)", reequip)
+        self.assertIn("line.v92LastReplaceYear <- AIDate.GetYear(AIDate.GetCurrentDate());", reequip)
+        self.assertIn('reason = "REEEQUIP_TIMEOUT"', reequip)
+        self.assertIn('OpexC56TaskLog("V92_REPLACE", "TIMEOUT"', reequip)
